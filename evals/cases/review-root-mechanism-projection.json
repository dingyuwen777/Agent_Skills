{
  "协议": "Agent Skills Outcome Eval Case/v1",
  "用例标识": "review-root-mechanism-projection",
  "任务族": "Review/Testing",
  "任务说明": "复杂 Review 第一次向作者发布 Findings 前，必须在同一 Review Target 上完成 coverage map、必要的 root-mechanism projection closure 与 blind omission pass，内部收敛后一次性发布；作者返修后的第二次 Review 只审原 Findings、repair diff、直接相邻回归与 Acceptance。若发现旧基线 escape，先内部合并校正，不逐条退给作者。简单 Review 保持有界。",
  "必需结果": [
    "root-mechanism-projection-closure",
    "first-pass-coverage",
    "first-review-publication-closure",
    "second-pass-delta-only",
    "consolidated-correction-if-escape",
    "finding-admission-valid",
    "repair-batch-single-rerequest",
    "delta-rereview"
  ],
  "必需证据": [
    "invariant-projection-evidence",
    "review-coverage-map-evidence"
  ],
  "禁止违规": [
    "sibling-projection-churn",
    "partial-finding-publication",
    "old-baseline-finding-as-normal-second-pass",
    "piecemeal-review-correction",
    "unbounded-rereview",
    "simple-review-overrouting",
    "speculative-blocker-repair",
    "per-finding-rerequest-churn",
    "duplicate-pr-for-review-repair"
  ],
  "上限": {
    "用户干预": 1
  }
}
